{
  "name": "@buildingthefuture/harnext",
  "version": "0.6.0",
  "description": "Choose, transfer, and sync chats across Claude Code, pi, Oh My Pi, and Codex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhinavMir/harnext.git"
  },
  "bugs": {
    "url": "https://github.com/AbhinavMir/harnext/issues"
  },
  "homepage": "https://github.com/AbhinavMir/harnext#readme",
  "type": "module",
  "bin": {
    "harnext": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "pi",
    "coding-agent",
    "session",
    "transcript",
    "migration",
    "prompt-export",
    "openrouter",
    "codex",
    "oh-my-pi",
    "sync"
  ],
  "dependencies": {
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
